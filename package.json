{
  "name": "@luyen/app",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.26.1+sha512.664074abc367d2c9324fdc18037097ce0a8f126034160f709928e9e9f95d98714347044e5c3164d65bd5da6c59c6be362b107546292a8eecb7999196e5ce58fa",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "pnpm": ">=7.0.0",
    "npm": "please use pnpm"
  },
  "scripts": {
    "packs:build": "pnpm --filter @luyen/infra-scripts packs:build",
    "packs:verify": "pnpm --filter @luyen/infra-scripts packs:verify",
    "build": "pnpm -r --if-present run build",
    "tauri:desktop": "cd desktop && tauri",
    "tauri:mobile": "cd mobile && tauri",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "check": "pnpm -r --if-present run check",
    "fix": "pnpm -r --if-present run fix",
    "e2e:web": "playwright test --config tests/web/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "2.12.6"
  }
}
